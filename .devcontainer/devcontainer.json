{
	"name": "maturin",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"mounts": [
		{
			"source": "uv",
			"target": "/home/vscode/.cache/uv",
			"type": "volume"
		},
		{
			"target": "${containerWorkspaceFolder}/.venv",
			"type": "volume"
		},
		{
			"target": "${containerWorkspaceFolder}/target",
			"type": "volume"
		}
	],
	"containerEnv": {
		"UV_LINK_MODE": "copy"
	},
	"onCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.cache/uv .venv target",
	"postCreateCommand": "uv sync",
	"customizations": {
		"vscode": {
			"extensions": [
				"charliermarsh.ruff",
				"ms-python.python",
				"rust-lang.rust-analyzer",
				"tamasfe.even-better-toml"
			]
		}
	}
}
